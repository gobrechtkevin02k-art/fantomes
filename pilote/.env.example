# Clé gratuite sur https://the-odds-api.com (500 crédits/mois offerts).
# Sans clé, l'application tourne en mode démo avec des matchs simulés.
ODDS_API_KEY=

# Optionnel : protège l'application par un mot de passe (utilisateur au choix).
# Fortement conseillé si tu la mets en ligne, sinon n'importe qui peut consommer ton quota.
APP_PASSWORD=
