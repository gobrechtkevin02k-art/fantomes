# --- Cotes Winamax -----------------------------------------------------------
# Clé gratuite sur https://the-odds-api.com (500 crédits/mois offerts).
# Sans clé, l'application tourne en mode démo avec des matchs simulés.
ODDS_API_KEY=

# --- Accès -------------------------------------------------------------------
# Protège l'application par un mot de passe (utilisateur au choix). Fortement conseillé en ligne.
APP_PASSWORD=

# --- Analyste IA (facultatif) ------------------------------------------------
# Clé Claude sur https://console.anthropic.com : active l'analyse de dernière minute (compositions, absences).
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut claude-opus-5-5) et nombre maximum d'analyses par heure.
# ANALYSE_MODELE=claude-opus-5-5
# ANALYSE_MAX_HEURE=30

# --- Notifications et agent autonome (facultatif) ----------------------------
# Clés VAPID : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact pour les services de notification (mailto:… ou https://…)
VAPID_SUBJECT=
# Secret exigé pour appeler /api/cron (toutes les 15 minutes).
CRON_SECRET=
# Stockage serveur (Upstash Redis, offre gratuite) : indispensable sur Vercel pour la synchro et l'agent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Abonnements (Stripe) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Codes de profil (séparés par des virgules) qui ont tout débloqué sans payer : le tien !
PILOTE_ACCES_COMPLET=
# Offre accordée par défaut (decouverte, essentiel, pro ou elite) : pratique pour tester.
# OFFRE_PAR_DEFAUT=decouverte
